# Token de Vercel con el que se crean y lanzan las tiendas (vercel.com/account/tokens)
LANZATIENDA_TOKEN=
# Solo si las tiendas se crean dentro de un equipo de Vercel (si no, déjalo vacío)
LANZATIENDA_TEAM_ID=
# Supabase (cuentas de usuario). Están en Supabase → Project Settings → API Keys.
# Ambas son públicas por diseño: NUNCA pongas aquí la secret key con el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key de Supabase (sb_secret_...). Solo la usa el servidor para guardar las tiendas.
# En Vercel guárdala como tipo "Secret" y SIN el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Comprar dominios dentro de Dropshype: el usuario paga con Stripe y el dominio se compra
# en tu cuenta de Vercel (necesita una tarjeta en Vercel → Settings → Billing).
# Sin STRIPE_SECRET_KEY se puede buscar dominios, pero no comprarlos.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → destino de «Tu cuenta» a https://TU-WEB/api/stripe/webhook
# con los eventos checkout.session.completed y checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
# Lo que ganas por cada dominio, en euros (se suma al precio de Vercel). Por defecto 3
DOMAIN_MARGIN_EUR=3
# Cambio de dólar a euro para calcular el precio. Por defecto 0.95
DOMAIN_USD_TO_EUR=0.95
# Precio máximo en dólares de un dominio que se puede vender (evita los "premium"). Por defecto 40
DOMAIN_MAX_USD=40
# Cobro con tarjeta en las tiendas (Stripe Connect, cuentas Standard): comisión opcional de Dropshype
# por cada venta, en % (de 0 a 20). Por defecto 0: el usuario se queda todo menos la comisión de Stripe
STORE_FEE_PERCENT=0
# Dirección pública de Dropshype a la que llaman las tiendas (analíticas y cobros).
# Si la dejas vacía se usa la dirección desde la que se publica la tienda
LANZATIENDA_URL=
